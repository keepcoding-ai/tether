{
  "name": "tether-remote-relay",
  "version": "0.1.0",
  "description": "Blind relay of the remote wire: proves houses and devices, routes opaque binary frames, keeps nothing on disk.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "serve": "node src/main.ts serve",
    "check": "tsc -p .",
    "test": "node --test --test-timeout=120000 test/core.test.ts && node --test --test-concurrency=1 --test-timeout=120000 test/wire.timing.test.ts"
  },
  "dependencies": {
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2"
  }
}
