{
  "name": "tether",
  "version": "0.1.0",
  "description": "Each terminal slot remembers which Claude Code / soul-cli session it runs, and resumes it after any restart.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "tether": "./bin/tether.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "daemon": "node src/daemon/main.ts"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
