{
  "name": "tether",
  "version": "0.1.1",
  "description": "Each terminal slot remembers which Claude Code / soul-cli session it runs, and resumes it after any restart.",
  "type": "module",
  "main": "app/dist/main.cjs",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "tether": "./bin/tether.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test --test-timeout=120000 \"test/unit/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "daemon": "node src/daemon/main.ts",
    "brand:derive": "node app/brand-derive.mjs",
    "emblems:derive": "node app/emblem-icons-derive.mjs",
    "bridge:build": "node extensions/web-bridge/build.mjs",
    "browser:vendor": "node extensions/browser/vendor.mjs",
    "app:build": "node app/build.mjs",
    "app:install": "node app/install.mjs install",
    "app:uninstall": "node app/install.mjs uninstall",
    "dist": "node app/build.mjs && electron-builder --win --x64 --config electron-builder.yml",
    "app": "node app/build.mjs && electron app/dist/main.cjs",
    "app:typecheck": "tsc -p app/renderer",
    "test:app": "node --test --test-concurrency=1 \"test/e2e/app.*.test.ts\""
  },
  "dependencies": {
    "@vscode/ripgrep": "1.18.0",
    "jsonc-parser": "3.3.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dockview-core": "^8.8.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.3",
    "monaco-editor": "^0.57.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
