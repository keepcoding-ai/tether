{
  "$schema": "./brand.schema.json",
  "slug": "tether",
  "name": "Tether Bridge",
  "shortName": "Tether",
  "description": "Deixa os agentes do Tether (Claude, soul) usarem este navegador, só nas abas que eles abriram ou que você entregou.",
  "host": {
    "name": "tether",
    "id": "studio.codr.tether"
  },
  "colors": {
    "accent": "#6aa6ff",
    "light": {
      "ink": "#1b1b1f",
      "paper": "#f4f4f7"
    },
    "dark": {
      "ink": "#e8e8ee",
      "paper": "#141418"
    }
  },
  "assets": {
    "src": "./src",
    "out": "./assets/bridge"
  },
  "extension": {
    "key": "",
    "locale": "pt-BR"
  },
  "mcp": {
    "serverName": "tether-bridge"
  },
  "tabs": {
    "groupTitle": "{shortName}",
    "agentTitle": "{shortName} · {agent}",
    "groupColor": "blue"
  },
  "capabilities": {
    "evaluate": "own-tabs",
    "download": true,
    "upload": true,
    "pdf": true,
    "readNetwork": true,
    "windowPerAgent": true
  }
}
